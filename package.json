{
	"name": "obsidian-table-formatter",
	"version": "0.2.1",
	"description": "Obsidian plugin that pastes HTML and ASCII tables as Markdown tables.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "npm run build && node scratch/run_tests.mjs"
	},
	"keywords": [
		"obsidian",
		"markdown",
		"table",
		"paste"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"linkedom": "^0.18.12",
		"obsidian": "^1.10.0",
		"tslib": "^2.8.1",
		"turndown": "^7.2.0",
		"typescript": "^5.8.3"
	}
}
